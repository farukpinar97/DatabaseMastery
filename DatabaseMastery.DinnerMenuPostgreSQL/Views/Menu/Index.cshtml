@model List<DatabaseMastery.DinnerMenuPostgreSQL.Dtos.ProductDtos.ResultProductDto>
@using DatabaseMastery.DinnerMenuPostgreSQL.Dtos.CategoryDtos
@{
    ViewData["Title"] = "Menü";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categories = ViewBag.Categories as List<ResultCategoryDto> ?? new List<ResultCategoryDto>();
    var selectedCategoryId = ViewBag.SelectedCategoryId as int?;
}

@if (TempData["ReviewSuccess"] != null)
{
    <div style="position:fixed;top:20px;right:20px;z-index:9998;
                    background:#1a1a1a;color:#fff;
                    padding:14px 20px;border-radius:4px;
                    font-family:'Poppins',sans-serif;font-size:13px;
                    box-shadow:0 8px 24px rgba(0,0,0,0.2);
                    display:flex;align-items:center;gap:8px;"
         id="successToast">
        <i class="fas fa-check-circle" style="color:#22c55e;"></i>
        @TempData["ReviewSuccess"]
    </div>
    <script>
        setTimeout(function () {
            var toast = document.getElementById('successToast');
            if (toast) toast.style.display = 'none';
        }, 4000);
    </script>
}

<!-- TOP IMAGE HEADER -->
<section class="topSingleBkg topPageBkg">
    <div class="item-content-bkg">
        <div class="item-img" style="background-image:url('/dina-html/images/top-headers/menu-1col-image.jpg');"></div>
        <div class="inner-desc">
            <h1 class="post-title single-post-title">Seçkin Tatlar Koleksiyonu</h1>
            <span class="post-subtitle">Lezzet dolu tabaklarımızın keyfini çıkarın</span>
        </div>
    </div>
</section>
<!-- /TOP IMAGE HEADER -->
<!-- KATEGORİ FİLTRE -->
<section style="padding: 10px 0 20px;">
    <div class="container">
        <div class="filter-wrap">
            <a href="/Menu/Index"
               class="btn-filter @(selectedCategoryId == null ? "active" : "")">
                Tümü
            </a>
            @foreach (var category in categories.Where(c => c.CategoryStatus))
            {
                <a href="/Menu/Index?categoryId=@category.CategoryId"
                   class="btn-filter @(selectedCategoryId == category.CategoryId ? "active" : "")">
                    @category.CategoryName
                </a>
            }
        </div>
    </div>
</section>
<!-- /KATEGORİ FİLTRE -->
<!-- MAIN WRAP CONTENT -->
<section class="menu-1col-content">
    <div class="container">
        <div class="row">
            <div class="col-md-10 offset-md-1">
                @{
                    var groupedProducts = Model
                    .GroupBy(p => new { p.CategoryId, p.CategoryName })
                    .ToList();
                }

                @if (!groupedProducts.Any())
                {
                    <div class="text-center" style="padding:60px 0;">
                        <p style="font-size:16px;color:#999;">Bu kategoride ürün bulunamadı.</p>
                        <a href="/Menu/Index" class="view-more" style="margin-top:20px;display:inline-block;">
                            Tüm Menüyü Gör
                        </a>
                    </div>
                }
                else
                {
                    @foreach (var categoryGroup in groupedProducts)
                    {
                        <div class="categ-name cat-header"
                             data-category="cat-@categoryGroup.Key.CategoryId"
                             style="display:block !important; visibility:visible !important;">
                            <h2>@categoryGroup.Key.CategoryName</h2>
                        </div>

                        <div class="menu-holder menu-1col cat-products"
                             data-category="cat-@categoryGroup.Key.CategoryId">
                            @for (int i = 0; i < categoryGroup.Count(); i++)
                            {
                                var product = categoryGroup.ElementAt(i);
                                bool isLast = (i % 2 == 1);

                                <div class="menu-post clearfix @(isLast ? "last" : "")">
                                    <div class="menu-post-img">
                                        <a href="@product.ImageUrl" class="lightbox" title="@product.ProductName">
                                            <img width="400" height="400"
                                                 src="@product.ImageUrl"
                                                 alt="@product.ProductName"
                                                 title="@product.ProductName" />
                                        </a>
                                    </div>
                                    <div class="menu-post-desc">
                                        <h4>
                                            <span class="menu-title">@product.ProductName</span>
                                            <span class="menu-dots"></span>
                                            <span class="menu-price">₺@product.Price.ToString("F2")</span>
                                        </h4>
                                        <div class="menu-text">@product.Description</div>
                                        <button class="review-btn"
                                                onclick="openReviewModal(@product.ProductId, '@Html.Raw(product.ProductName.Replace("'", "\\'"))')">
                                            <i class="fas fa-star"></i> Değerlendir
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>
<!-- /MAIN WRAP CONTENT -->
<!-- DEĞERLENDİRME MODAL -->
<div id="reviewModal" class="review-modal-overlay" style="display:none;">
    <div class="review-modal-box">
        <div class="review-modal-header">
            <div>
                <div style="font-size:11px;color:#aaa;text-transform:uppercase;letter-spacing:.06em;margin-bottom:4px;">
                    Değerlendirme
                </div>
                <h3 id="reviewProductName"
                    style="font-family:'Lora',serif;font-size:20px;font-weight:700;color:#1a1a1a;margin:0;"></h3>
            </div>
            <button onclick="closeReviewModal()" class="review-close-btn">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <form action="/Review/CreateUserReview" method="post" id="reviewForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ProductId" id="reviewProductId" />
            <input type="hidden" name="Status" value="false" />

            <div class="review-modal-body">
                <div class="review-field">
                    <label class="review-label">Puanınız</label>
                    <div class="star-selector" id="starSelector">
                        @for (int s = 1; s <= 5; s++)
                        {
                            <span class="star-item" data-value="@s" onclick="selectStar(@s)">★</span>
                        }
                    </div>
                    <input type="hidden" name="Rating" id="ratingInput" value="0" />
                    <div id="ratingError" style="color:#e74c3c;font-size:12px;display:none;">
                        Lütfen bir puan seçin.
                    </div>
                </div>

                <div class="review-field">
                    <label class="review-label">Ad Soyad</label>
                    <input type="text" name="CustomerName" class="review-input"
                           placeholder="Adınız Soyadınız" required />
                </div>

                <div class="review-field">
                    <label class="review-label">Yorumunuz</label>
                    <textarea name="Comment" class="review-input" rows="4"
                              placeholder="Bu ürün hakkında düşüncelerinizi paylaşın..."
                              required></textarea>
                </div>
            </div>

            <div class="review-modal-footer">
                <button type="button" onclick="closeReviewModal()" class="review-cancel-btn">
                    Vazgeç
                </button>
                <button type="submit" onclick="return validateReview()" class="review-submit-btn">
                    <i class="fas fa-paper-plane"></i> Gönder
                </button>
            </div>
        </form>
    </div>
</div>
<!-- /DEĞERLENDİRME MODAL -->
@section Styles {
    <style>
        /* Kategori başlığı */
        .categ-name h2 {
            height: auto !important;
            min-height: 40px !important;
            width: 100% !important;
            display: block !important;
        }

        /* Filtre butonları */
        .filter-wrap {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 8px;
            padding: 30px 0;
        }

        .btn-filter {
            font-family: 'Poppins', sans-serif;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #1a1a1a;
            border: 2px solid #1a1a1a;
            padding: 9px 20px;
            text-decoration: none;
            display: inline-block;
            transition: all 0.2s ease;
            background: transparent;
        }

            .btn-filter:hover,
            .btn-filter.active {
                background: #1a1a1a;
                color: #fff;
            }

        /* Değerlendir butonu */
        .review-btn {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-top: 8px;
            background: transparent;
            border: 1px solid #1a1a1a;
            color: #1a1a1a;
            padding: 5px 14px;
            font-family: 'Poppins', sans-serif;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .06em;
            cursor: pointer;
            transition: all 0.2s ease;
            border-radius: 2px;
        }

            .review-btn:hover {
                background: #1a1a1a;
                color: #fff;
            }

            .review-btn i {
                font-size: 10px;
                color: #e6a03c;
            }

        /* Modal */
        .review-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.55);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            backdrop-filter: blur(3px);
        }

        .review-modal-box {
            background: #fff;
            border-radius: 6px;
            width: 100%;
            max-width: 480px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
            overflow: hidden;
        }

        .review-modal-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            padding: 24px 26px 18px;
            border-bottom: 1px solid #f0ede8;
        }

        .review-close-btn {
            background: #f5f2ee;
            border: none;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: #888;
            font-size: 13px;
            transition: all 0.2s;
            flex-shrink: 0;
        }

            .review-close-btn:hover {
                background: #1a1a1a;
                color: #fff;
            }

        .review-modal-body {
            padding: 20px 26px;
        }

        .review-field {
            margin-bottom: 18px;
        }

        .review-label {
            display: block;
            font-family: 'Poppins', sans-serif;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #888;
            margin-bottom: 8px;
        }

        .review-input {
            width: 100%;
            border: 1px solid #ddd;
            border-radius: 3px;
            padding: 10px 14px;
            font-family: 'Poppins', sans-serif;
            font-size: 13px;
            color: #333;
            outline: none;
            transition: border-color 0.2s;
            resize: none;
        }

            .review-input:focus {
                border-color: #1a1a1a;
            }

        .star-selector {
            display: flex;
            gap: 6px;
        }

        .star-item {
            font-size: 28px;
            color: #ddd;
            cursor: pointer;
            transition: all 0.15s;
            line-height: 1;
        }

            .star-item:hover,
            .star-item.selected {
                color: #e6a03c;
                transform: scale(1.15);
            }

        .review-modal-footer {
            display: flex;
            gap: 10px;
            padding: 16px 26px 22px;
            border-top: 1px solid #f0ede8;
        }

        .review-cancel-btn {
            flex: 1;
            border: 1px solid #ddd;
            background: #fff;
            border-radius: 3px;
            padding: 11px;
            font-family: 'Poppins', sans-serif;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #888;
            cursor: pointer;
            transition: all 0.2s;
        }

            .review-cancel-btn:hover {
                background: #f5f2ee;
                color: #333;
            }

        .review-submit-btn {
            flex: 2;
            border: none;
            background: #1a1a1a;
            color: #fff;
            border-radius: 3px;
            padding: 11px;
            font-family: 'Poppins', sans-serif;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .06em;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

            .review-submit-btn:hover {
                background: #333;
            }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('reviewModal').addEventListener('click', function (e) {
                if (e.target === this) closeReviewModal();
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeReviewModal();
            });
        });

        function openReviewModal(productId, productName) {
            document.getElementById('reviewProductId').value = productId;
            document.getElementById('reviewProductName').textContent = productName;
            document.getElementById('ratingInput').value = 0;
            document.getElementById('ratingError').style.display = 'none';
            document.querySelectorAll('.star-item').forEach(function (s) {
                s.classList.remove('selected');
            });
            document.getElementById('reviewModal').style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function closeReviewModal() {
            document.getElementById('reviewModal').style.display = 'none';
            document.body.style.overflow = '';
        }

        function selectStar(value) {
            document.getElementById('ratingInput').value = value;
            document.getElementById('ratingError').style.display = 'none';
            document.querySelectorAll('.star-item').forEach(function (star, index) {
                if (index < value) {
                    star.classList.add('selected');
                } else {
                    star.classList.remove('selected');
                }
            });
        }

        function validateReview() {
            var rating = document.getElementById('ratingInput').value;
            if (!rating || rating == 0) {
                document.getElementById('ratingError').style.display = 'block';
                return false;
            }
            return true;
        }
    </script>
}