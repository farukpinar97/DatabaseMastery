@section Scripts {
    <script>
        var allRows  = [];
        var filtered = [];
        var curPage  = 1;
        var perPage  = 20;

        document.addEventListener('DOMContentLoaded', function () {
            allRows  = Array.from(document.querySelectorAll('#conBody tr[data-name]'));
            filtered = allRows.slice();
            renderPagination();
            showPage(1);
        });

        function filterTable() {
            var q      = document.getElementById('searchInput').value.toLowerCase().trim();
            var status = document.getElementById('statusFilter').value;
            var date   = document.getElementById('dateFilter').value;

            filtered = allRows.filter(function (row) {
                var nm = (row.dataset.name    || '').includes(q) ||
                         (row.dataset.email   || '').includes(q) ||
                         (row.dataset.subject || '').includes(q);
                var sm = status === 'all' || row.dataset.status    === status;
                var dm = date   === 'all' || row.dataset.dategroup === date;
                return nm && sm && dm;
            });

            curPage = 1; renderPagination(); showPage(1); updateCounts();
        }

        function renderPagination() {
            var pages = Math.ceil(filtered.length / perPage);
            var pag   = document.getElementById('pagination');
            if (!pag || pages <= 1) { if (pag) pag.innerHTML = ''; return; }

            var html = '<button class="pag-btn" ' + (curPage <= 1 ? 'disabled' : '') + ' onclick="goPage(' + (curPage - 1) + ')"><i class="bi bi-chevron-left"></i></button>';
            for (var i = 1; i <= pages; i++) {
                html += '<button class="pag-btn ' + (i === curPage ? 'active' : '') + '" onclick="goPage(' + i + ')">' + i + '</button>';
            }
            html += '<button class="pag-btn" ' + (curPage >= pages ? 'disabled' : '') + ' onclick="goPage(' + (curPage + 1) + ')"><i class="bi bi-chevron-right"></i></button>';
            pag.innerHTML = html;
        }

        function goPage(n) {
            curPage = n; showPage(n); renderPagination();
            document.querySelector('.tbl-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function showPage(n) {
            var start = (n - 1) * perPage, end = start + perPage;
            allRows.forEach(function (r) { r.style.display = 'none'; });
            filtered.forEach(function (r, i) {
                r.style.display = (i >= start && i < end) ? '' : 'none';
                var chip = r.querySelector('.row-num');
                if (chip) chip.textContent = i + 1;
            });
        }

        function updateCounts() {
            var vc = document.getElementById('visibleCount');
            if (vc) vc.textContent = filtered.length;
            var rc = document.getElementById('resultCount');
            if (rc) rc.textContent = filtered.length + ' mesaj';
        }

        // Mesaj detay modalı
        function showMessage(id, name, email, subject, message, date, isRead) {
            document.getElementById('modalName').textContent    = name;
            document.getElementById('modalEmail').textContent   = email;
            document.getElementById('modalEmail').href          = 'mailto:' + email;
            document.getElementById('modalSubject').textContent = subject;
            document.getElementById('modalMessage').textContent = message.replace(/\\n/g, '\n');
            document.getElementById('modalDate').textContent    = date;

            var markReadBtn = document.getElementById('modalMarkRead');
            if (isRead) {
                markReadBtn.style.display = 'none';
            } else {
                markReadBtn.style.display = 'inline-flex';
                markReadBtn.href = '/Contact/MarkAsRead/' + id;
            }

            new bootstrap.Modal(document.getElementById('messageModal')).show();
        }

        // Silme onay modalı
        function confirmDelete(id, name) {
            document.getElementById('delContactName').textContent = name;
            document.getElementById('delLink').href = '/Contact/DeleteContact/' + id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}