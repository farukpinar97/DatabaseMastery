<!-- DELETE MODAL -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
        <div class="modal-content del-mc">
            <div class="del-mb">
                <div style="width:62px;height:62px;background:#fff5f5;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:24px;color:#ef4444;border:1.5px solid #fecaca;">
                    <i class="bi bi-trash3-fill"></i>
                </div>
                <div class="del-mt">Mesaj Silinsin mi?</div>
                <p style="font-size:13.5px;color:#888;margin-bottom:4px;">
                    <strong id="delContactName" style="color:#333;"></strong> adlı kişinin mesajı kalıcı olarak silinecek.
